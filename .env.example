# DotEnvUp sample — fake typical project secrets (copy to .env to test)
# DO NOT use these values in production — they are placeholders only.
# Avoid provider-shaped fake keys (sk_test_*, whsec_*, etc.) — secret scanners flag them.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=example_db_password_not_real
DATABASE_URL=postgresql://app_user:example_db_password_not_real@localhost:5432/myapp

# API Keys (non-provider-shaped placeholders)
API_KEY=example_api_key_not_real
API_SECRET=example_api_secret_not_real
STRIPE_SECRET_KEY=example_stripe_secret_not_real
STRIPE_WEBHOOK_SECRET=example_stripe_webhook_not_real

# Auth / Session
JWT_SECRET=example_jwt_secret_replace_me_32b
SESSION_SECRET=example_session_secret_not_real
COOKIE_SECRET=example_cookie_secret_not_real

# Redis / Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=example_redis_password_not_real

# External services (AWS docs use AKIA…EXAMPLE — keep clearly labeled)
SENDGRID_API_KEY=example_sendgrid_key_not_real
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# App config
NODE_ENV=development
LOG_LEVEL=debug

# CLI tokens (optional) — so agents can run tools as you without `cli login`
# (login overwrites your personal Railway/GitHub/etc. accounts). User fills values; do not invent them.
# RAILWAY_API_TOKEN=
# GH_TOKEN=
# CLOUDFLARE_API_TOKEN=
# NETLIFY_AUTH_TOKEN=
