{
  "name": "@dotenvup/node",
  "version": "0.1.0",
  "description": "Drop-in dotenv replacement that reads encrypted .env.up files",
  "keywords": [
    "dotenv",
    "env",
    "encrypted",
    "secrets",
    "environment",
    "dotenvup",
    "node"
  ],
  "homepage": "https://dotenvup.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarhej/dotenvup.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "author": "UnknownPassword",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dotenvup/format": "*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.7.0"
  }
}
