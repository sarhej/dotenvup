{
  "name": "dotenvup",
  "displayName": ".env Up (DotEnvUp)",
  "version": "0.7.0",
  "description": ".env encryption: encrypt .env into .env.up. VS Code/Cursor extension + CLI (up). Encrypted local identity; opt-in macOS Keychain + session agent; lock/unlock, Safe Edit, up run --, MCP. Zero-knowledge. CLI: npm i -g @dotenvup/cli.",
  "publisher": "dotenvup",
  "keywords": [
    ".env",
    ".env encryption",
    "encrypt .env",
    "encrypted .env",
    "dotenv",
    "env",
    "encrypted",
    "secrets",
    "environment",
    "security",
    "environment variables",
    "secret manager",
    "api keys",
    "encrypt env",
    "vscode dotenv",
    "cursor dotenv",
    "ai secrets",
    "dotenv security",
    "zero knowledge",
    "zero trust",
    "no cloud",
    "cli",
    "up command",
    "dotenvup-cli",
    "mcp",
    "model context protocol"
  ],
  "homepage": "https://dotenvup.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarhej/dotenvup.git",
    "directory": "packages/vscode-dotenvup"
  },
  "bugs": {
    "url": "https://github.com/sarhej/dotenvup/issues"
  },
  "author": {
    "name": "Sergej Fedorovic",
    "url": "https://strt.it"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.env.up",
    "workspaceContains:**/.env",
    "onCustomEditor:dotenvup.safeEdit",
    "onLanguage:dotenvup"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc && node esbuild.mjs && node scripts/copy-keychain-helper.mjs",
    "clean": "rm -rf dist bin/dotenvup-keychain",
    "lint": "tsc --noEmit",
    "test": "DOTENVUP_TEST=1 HOME=$PWD/.vscode-test/home USERPROFILE=$PWD/.vscode-test/home DOTENVUP_IDENTITY_DIR=$PWD/.vscode-test/.dotenvup-test-identity DOTENVUP_TEST_IDENTITY_DIR=$PWD/.vscode-test/.dotenvup-test-identity vscode-test",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "dotenvup.init",
        "title": "DotEnvUp: Init (generate keypair)"
      },
      {
        "command": "dotenvup.lock",
        "title": "DotEnvUp: Lock .env.up"
      },
      {
        "command": "dotenvup.unlock",
        "title": "DotEnvUp: Unlock .env.up"
      },
      {
        "command": "dotenvup.import",
        "title": "DotEnvUp: Import .env to .env.up"
      },
      {
        "command": "dotenvup.importAll",
        "title": "DotEnvUp: Import all .env.* files"
      },
      {
        "command": "dotenvup.showKeys",
        "title": "DotEnvUp: Show Keys (no decryption)"
      },
      {
        "command": "dotenvup.status",
        "title": "DotEnvUp: Secret Status & Freshness"
      },
      {
        "command": "dotenvup.keyManagement",
        "title": "DotEnvUp: Key Management"
      },
      {
        "command": "dotenvup.keyExport",
        "title": "DotEnvUp: Export key bundle"
      },
      {
        "command": "dotenvup.keyImport",
        "title": "DotEnvUp: Import key bundle"
      },
      {
        "command": "dotenvup.keyStorageStatus",
        "title": "DotEnvUp: Key Storage Status"
      },
      {
        "command": "dotenvup.recoverKeyMismatch",
        "title": "DotEnvUp: Recover key mismatch"
      },
      {
        "command": "dotenvup.recipientsList",
        "title": "DotEnvUp: Recipients list"
      },
      {
        "command": "dotenvup.recipientsAdd",
        "title": "DotEnvUp: Add recipient"
      },
      {
        "command": "dotenvup.recipientsRemove",
        "title": "DotEnvUp: Remove recipient"
      },
      {
        "command": "dotenvup.recipientsDiscover",
        "title": "DotEnvUp: Discover recipient keys"
      },
      {
        "command": "dotenvup.safeEdit",
        "title": "Edit with DotEnvUp (Safe Edit)"
      },
      {
        "command": "dotenvup.unlockFromContext",
        "title": "DotEnvUp: Unlock to Disk"
      },
      {
        "command": "dotenvup.lockFromContext",
        "title": "DotEnvUp: Lock"
      },
      {
        "command": "dotenvup.copyMyPublicKey",
        "title": "DotEnvUp: Copy My Public Key"
      },
      {
        "command": "dotenvup.encryptForRecipient",
        "title": "DotEnvUp: Encrypt for Recipient"
      },
      {
        "command": "dotenvup.receiveShare",
        "title": "DotEnvUp: Receive Encrypted Share"
      },
      {
        "command": "dotenvup.copyMcpConfig",
        "title": "DotEnvUp: Copy MCP config for Cursor"
      },
      {
        "command": "dotenvup.encryptForGitHub",
        "title": "DotEnvUp: Encrypt for GitHub User"
      },
      {
        "command": "dotenvup.decryptSealed",
        "title": "DotEnvUp: Decrypt Sealed File"
      }
    ],
    "languages": [
      {
        "id": "dotenvup",
        "extensions": [
          ".env.up",
          ".up"
        ],
        "aliases": [
          "DotEnvUp",
          "envup",
          "UnknownPassword Encrypted Env"
        ],
        "mimetypes": [
          "application/vnd.dotenvup.encrypted",
          "application/x-env-up"
        ],
        "icon": {
          "light": "./icons/dotenvup-light.svg",
          "dark": "./icons/dotenvup-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dotenvup",
        "scopeName": "source.dotenvup",
        "path": "./syntaxes/dotenvup.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "DotEnvUp",
      "properties": {
        "dotenvup.confirmOnLock": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation dialog before locking (deleting .env)."
        },
        "dotenvup.defaultUnlockDuration": {
          "type": "string",
          "default": "5m",
          "description": "Default unlock duration (e.g. 5m, 15m, 1h)."
        },
        "dotenvup.staleDays": {
          "type": "number",
          "default": 90,
          "description": "Number of days after which keys are considered stale."
        },
        "dotenvup.autoLockOnClose": {
          "type": "boolean",
          "default": true,
          "description": "Lock (remove .env) when VS Code is closed."
        },
        "dotenvup.createBackupBeforeLock": {
          "type": "boolean",
          "default": true,
          "description": "Before locking, save an encrypted backup of .env.up as .env.up.bak-<timestamp>. No plaintext backup."
        },
        "dotenvup.encryptAllEnvFiles": {
          "type": "boolean",
          "default": false,
          "description": "Encrypt all .env.* files in the project (e.g. .env.local, .env.development), not only .env. Excludes files already ending in .up."
        },
        "dotenvup.keyStorageMode": {
          "type": "string",
          "enum": [
            "user-file",
            "keychain"
          ],
          "default": "user-file",
          "description": "Preferred key storage label for UI. Actual storage is detected from ~/.dotenvup (file-envelope or Keychain after `up key migrate-to-keychain`). Keychain is macOS opt-in."
        },
        "dotenvup.session.idleTtl": {
          "type": "string",
          "default": "30m",
          "description": "Session agent idle TTL after last use (e.g. 30m). Wiped earlier on screen lock / sleep / logout."
        },
        "dotenvup.session.absoluteTtl": {
          "type": "string",
          "default": "8h",
          "description": "Session agent absolute TTL hard cap (max 12h)."
        },
        "dotenvup.onlyWorkspaceRoot": {
          "type": "boolean",
          "default": false,
          "description": "Only consider .env/.env.up in the workspace folder root(s), not in subfolders. Use when you want a single entry (e.g. \"Unlock unrelai\") instead of every subfolder with .env."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "dotenvup.safeEdit",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up'",
          "group": "navigation"
        },
        {
          "command": "dotenvup.unlockFromContext",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up'",
          "group": "navigation"
        },
        {
          "command": "dotenvup.lockFromContext",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up'",
          "group": "navigation"
        },
        {
          "command": "dotenvup.copyMyPublicKey",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up'",
          "group": "2_sharing"
        },
        {
          "command": "dotenvup.encryptForRecipient",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up'",
          "group": "2_sharing"
        },
        {
          "command": "dotenvup.encryptForGitHub",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourceFilename =~ /\\.env\\.up$/ || resourceExtname == '.up' || resourcePath =~ /\\.env$/ || resourceFilename == '.env'",
          "group": "2_sharing"
        },
        {
          "command": "dotenvup.decryptSealed",
          "when": "resourcePath =~ /\\.sealed$/ || resourceFilename =~ /\\.sealed$/",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "dotenvup.safeEdit",
          "when": "resourcePath =~ /\\.env\\.up$/",
          "group": "navigation"
        },
        {
          "command": "dotenvup.unlockFromContext",
          "when": "resourcePath =~ /\\.env\\.up$/",
          "group": "navigation"
        },
        {
          "command": "dotenvup.lockFromContext",
          "when": "resourcePath =~ /\\.env\\.up$/",
          "group": "navigation"
        },
        {
          "command": "dotenvup.copyMyPublicKey",
          "when": "resourcePath =~ /\\.env\\.up$/",
          "group": "2_sharing"
        },
        {
          "command": "dotenvup.encryptForRecipient",
          "when": "resourcePath =~ /\\.env\\.up$/",
          "group": "2_sharing"
        },
        {
          "command": "dotenvup.encryptForGitHub",
          "when": "resourcePath =~ /\\.env\\.up$/ || resourcePath =~ /\\.env$/",
          "group": "2_sharing"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dotenvup.safeEdit",
        "displayName": "DotEnvUp Safe Edit",
        "selector": [
          {
            "filenamePattern": ".env.up"
          },
          {
            "filenamePattern": "*.env.up"
          },
          {
            "filenamePattern": "*.up"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "devDependencies": {
    "@dotenvup/format": "*",
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  }
}
