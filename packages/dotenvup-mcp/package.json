{
  "name": "@dotenvup/mcp",
  "version": "0.1.0",
  "description": "MCP server for DotEnvUp — status, keys, and run commands with decrypted env (no secrets over the wire)",
  "keywords": [
    "dotenvup",
    "mcp",
    "model-context-protocol",
    "env",
    "secrets"
  ],
  "homepage": "https://dotenvup.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarhej/dotenvup.git",
    "directory": "packages/dotenvup-mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dotenvup-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@dotenvup/cli": "*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
